{
  "expo": {
    "name": "Block Puzzle: Streak",
    "slug": "block-puzzle-streak",
    "scheme": "blockpuzzlestreak",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.hunghd.blockpuzzlestreak",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Block Streak"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
